# Backend Environment Configuration Example
# Copy this file to backend/.env and configure your values

PORT=3001

# Google Maps & Gemini API Keys
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Storage (Bucket name and optional credential file path)
GCS_BUCKET=tree-hazard-images-503718
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Optional Supabase Configuration (Leave empty to use in-memory store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
