# Frontend Environment Configuration Example
# Copy this file to .env and configure your values

# Google Maps / Geocoding API Key (Required for map features)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key (For AI vision and hazard scoring integration)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Supabase Configuration (Leave blank for in-memory store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Backend API base URL
VITE_API_BASE=http://localhost:3001/api
