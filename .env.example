# ---------------------------------------------------------------------------
# Database — Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Pick the right one for how you run this:
#
#   Session pooler   port 5432 on *.pooler.supabase.com   <- USE THIS for
#                    long-lived Node servers (next dev / next start). IPv4.
#
#   Transaction pooler  port 6543                          serverless / edge
#                    only. Does not support session-level features.
#
#   Direct           db.<ref>.supabase.co:5432             IPv6-only on many
#                    projects; fails on IPv4-only networks. Prefer the pooler.
#
# Remember to URL-encode special characters in the password (@ -> %40 etc).
# Do NOT append ?sslmode=require. pg >= 8.23 treats it as verify-full, which
# rejects Supabase's certificate chain with "self-signed certificate in
# certificate chain" no matter what else you set. TLS is enabled by the app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS is always on. Certificate *verification* is off by default because
# Supabase's chain is not in most trust stores. Set true only if you have
# installed Supabase's CA certificate.
DATABASE_SSL_STRICT=false

# Maximum pooled connections held by this process.
# Supabase free tier allows 60 total across all clients - keep this modest.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Photo analysis (optional)
# ---------------------------------------------------------------------------
# Without a key the app falls back to text-only triage and says so in the UI.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Google Maps Platform (optional)
# ---------------------------------------------------------------------------
# One key drives two things:
#
#   Geocoding API    resident address -> coordinates, carrying the precision the
#                    provider reports (ROOFTOP / RANGE_INTERPOLATED / ...).
#   Maps Static API  the roadmap raster behind the operations map and the
#                    location panel, fetched server-side through /api/map.
#
# Enable BOTH APIs in the Google Cloud project. Without the key the app falls
# back to the local Halifax gazetteer and a coordinate plot with no streets.
#
# Server-side only - never prefix with NEXT_PUBLIC_. If the key is restricted,
# allow the server's IP rather than an HTTP referrer: the requests come from
# Node, not from the page.
GOOGLE_MAPS_API_KEY=

# Signs /api/map URLs so the basemap proxy cannot be used as free image hosting
# billed to this project. Defaults to the key above; set it to any random string
# to keep the two separate.
# MAP_PROXY_SECRET=

# Legacy Nominatim-compatible fallback, used only when no Google key is set.
GEOCODER_URL=

# ---------------------------------------------------------------------------
# Admin console access
# ---------------------------------------------------------------------------
# The resident form at / is public. Everything under /admin sits behind one
# shared staff account, because the queue exposes resident names and emails.
# Defaults are admin / admin - change them for anything reachable from a network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Signs the session cookie. Defaults to DATABASE_URL, which is already a
# server-only secret; set it explicitly to invalidate every session at once.
# ADMIN_SESSION_SECRET=

# Sessions expire after this many hours - one shift, so a shared depot terminal
# does not stay signed in overnight.
# ADMIN_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Uploaded photos
# ---------------------------------------------------------------------------
# Local filesystem path. Note this does NOT work on serverless hosting - see the
# README note about moving uploads to Supabase Storage.
UPLOAD_DIR=var/uploads

# ---------------------------------------------------------------------------
# Crew planning (optional — sensible defaults in src/backend/config.ts)
# ---------------------------------------------------------------------------
# CREW_SHIFT_HOURS=8
# CREW_MAX_DETOUR_M=1000
# CREW_TRAVEL_KMH=22
# CREW_SETUP_MINUTES=20
# CREW_MAX_RECOMMENDATIONS=5
